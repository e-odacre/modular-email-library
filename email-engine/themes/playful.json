{
  "name": "Playful",
  "description": "Friendly and bouncy: big rounded corners, pill buttons, soft shadows and chunky headings.",
  "overrides": {
    "type": {
      "display": {
        "size": "48px",
        "weight": "800"
      },
      "h1": {
        "size": "32px",
        "weight": "800"
      },
      "h2": {
        "size": "24px",
        "weight": "800"
      },
      "body": {
        "lineHeight": "1.6"
      },
      "button": {
        "weight": "800"
      }
    },
    "radius": {
      "small": "6px",
      "medium": "12px",
      "large": "24px",
      "pill": "999px"
    }
  },
  "button": {
    "radius": "@radius.pill",
    "innerPadding": "16px 32px",
    "borderWidth": "0"
  },
  "card": {
    "background": "@colors.surface",
    "border": "@colors.border",
    "borderWidth": "2px",
    "radius": "@radius.large",
    "padding": "@spacing.lg",
    "shadow": "small"
  },
  "section": {
    "paddingY": "@spacing.xl",
    "paddingX": "@spacing.lg",
    "paddingTight": "@spacing.sm"
  },
  "badge": {
    "background": "@colors.accent",
    "color": "@colors.white",
    "radius": "@radius.pill"
  },
  "divider": {
    "width": "2px",
    "color": "@colors.border",
    "style": "dashed"
  },
  "image": {
    "radius": "@radius.large"
  },
  "accent": {
    "color": "@colors.accent",
    "lineWidth": "6px",
    "lineLength": "56px"
  },
  "components": {
    "commerce/product-card": {
      "variant": "playful"
    },
    "commerce/product-grid": {
      "variant": "playful"
    },
    "decorative/badge": {
      "variant": "pill"
    }
  }
}
