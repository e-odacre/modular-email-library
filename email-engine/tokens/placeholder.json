{
  "_placeholders": [
    "brand.name",
    "colors.primary",
    "colors.primaryText",
    "colors.secondary",
    "colors.accent",
    "colors.success",
    "colors.warning",
    "colors.error",
    "colors.background",
    "colors.surface",
    "colors.text",
    "colors.mutedText",
    "colors.border",
    "colors.link",
    "fonts.heading",
    "fonts.body",
    "logo.url",
    "logo.alt",
    "logo.href",
    "images.hero"
  ],
  "brand": {
    "name": "Placeholder Brand"
  },
  "colors": {
    "primary": "#1F2937",
    "primaryText": "#FFFFFF",
    "secondary": "#4B5563",
    "accent": "#B45309",
    "success": "#15803D",
    "warning": "#B45309",
    "error": "#B91C1C",
    "white": "#FFFFFF",
    "black": "#000000",
    "background": "#F3F4F6",
    "surface": "#FFFFFF",
    "text": "#111827",
    "mutedText": "#6B7280",
    "border": "#E5E7EB",
    "link": "#2563EB"
  },
  "fonts": {
    "heading": "Helvetica, Arial, sans-serif",
    "body": "Arial, Helvetica, sans-serif"
  },
  "type": {
    "display":   { "font": "heading", "size": "44px", "weight": "700", "lineHeight": "1.1", "letterSpacing": "-0.5px", "transform": "none",      "color": "text" },
    "h1":        { "font": "heading", "size": "30px", "weight": "700", "lineHeight": "1.2", "letterSpacing": "0px",    "transform": "none",      "color": "text" },
    "h2":        { "font": "heading", "size": "22px", "weight": "700", "lineHeight": "1.3", "letterSpacing": "0px",    "transform": "none",      "color": "text" },
    "h3":        { "font": "heading", "size": "18px", "weight": "700", "lineHeight": "1.3", "letterSpacing": "0px",    "transform": "none",      "color": "text" },
    "h4":        { "font": "heading", "size": "16px", "weight": "700", "lineHeight": "1.4", "letterSpacing": "0px",    "transform": "none",      "color": "text" },
    "body":      { "font": "body",    "size": "16px", "weight": "400", "lineHeight": "1.5", "letterSpacing": "0px",    "transform": "none",      "color": "text" },
    "bodyLarge": { "font": "body",    "size": "18px", "weight": "400", "lineHeight": "1.6", "letterSpacing": "0px",    "transform": "none",      "color": "text" },
    "bodySmall": { "font": "body",    "size": "14px", "weight": "400", "lineHeight": "1.5", "letterSpacing": "0px",    "transform": "none",      "color": "text" },
    "caption":   { "font": "body",    "size": "12px", "weight": "400", "lineHeight": "1.5", "letterSpacing": "0px",    "transform": "none",      "color": "mutedText" },
    "eyebrow":   { "font": "heading", "size": "12px", "weight": "700", "lineHeight": "1.4", "letterSpacing": "2px",    "transform": "uppercase", "color": "accent" },
    "price":     { "font": "heading", "size": "20px", "weight": "700", "lineHeight": "1.2", "letterSpacing": "0px",    "transform": "none",      "color": "text" },
    "salePrice": { "font": "heading", "size": "20px", "weight": "700", "lineHeight": "1.2", "letterSpacing": "0px",    "transform": "none",      "color": "error" },
    "button":    { "font": "heading", "size": "16px", "weight": "700", "lineHeight": "1.2", "letterSpacing": "0px",    "transform": "none",      "color": "primaryText" }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "radius": {
    "none": "0",
    "small": "2px",
    "medium": "4px",
    "large": "8px",
    "pill": "999px"
  },
  "shadow": {
    "none": "none",
    "small": "0 1px 3px rgba(17,24,39,0.10)",
    "medium": "0 4px 12px rgba(17,24,39,0.12)",
    "large": "0 12px 32px rgba(17,24,39,0.16)"
  },
  "layout": {
    "width": "600px"
  },
  "logo": {
