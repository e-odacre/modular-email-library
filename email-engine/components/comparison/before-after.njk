[# comparison/before-after: two images side by side, labelled Before and After, with a caption under each.

   On phones the two stack, Before above After. Each image needs alt text that describes what it shows, especially the
   difference. Only use real before and after photos.

   Compatibility
   - Outlook desktop: two columns as a table row.
   - Gmail apps: stacking works. Gmail on non-Google accounts drops media queries and shows the desktop layout.
   - Dark mode: swaps via dm-* classes when on the brand surface or background color, images are not recolored. #]
[% set left = [{ component: 'decorative/badge', data: { text: data.before.label }, variant: 'outline', settings: { align: 'center' } }, { component: 'content/image', data: { image: data.before.image }, settings: { padding: '0 0 @spacing.xs 0' } }] %]
[% if data.before.caption %][% set _ = left.push({ component: 'content/text', data: { text: data.before.caption }, settings: { level: 'caption', align: 'center', padding: '0' } }) %][% endif %]
[% set right = [{ component: 'decorative/badge', data: { text: data.after.label }, settings: { align: 'center' } }, { component: 'content/image', data: { image: data.after.image }, settings: { padding: '0 0 @spacing.xs 0' } }] %]
[% if data.after.caption %][% set _ = right.push({ component: 'content/text', data: { text: data.after.caption }, settings: { level: 'caption', align: 'center', padding: '0' } }) %][% endif %]
[% if data.heading %]
[[ c('layout/section', { content: [{ component: 'content/heading', data: { text: data.heading }, settings: { level: 'h2', align: 'center', padding: '@spacing.sm' } }] }, { settings: { background: s.background, padding: s.paddingY + ' ' + s.paddingX + ' 0 ' + s.paddingX, hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
[% endif %]
[[ c('layout/columns', { columns: [left, right] }, { settings: { split: '50/50', valign: 'top', background: s.background, padding: s.paddingY + ' ' + s.paddingX, columnPadding: '0 @spacing.xs', hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
