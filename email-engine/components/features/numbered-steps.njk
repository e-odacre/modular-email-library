[# features/numbered-steps: a numbered sequence: 01 Choose your plan, 02 Customize, 03 Enjoy. Vertical rows or a horizontal row.

   Each step has a title and an optional description. Numbers come from the step order, written 1, 2, 3 or 01, 02, 03
   (numbering) in the plain, circle or outline marker style (shape). Vertical steps keep the number beside the text
   on phones, horizontal steps stack.

   Compatibility
   - Outlook desktop: number markers are table cells, honored. Circles render as squares.
   - Gmail apps: fine. Horizontal steps stack on phones through a media query, Gmail on non-Google accounts keeps
     the desktop row.
   - Dark mode: swaps via dm-* classes when on the brand surface or background color. #]
[% set head = [] %]
[% if data.heading %][% set _ = head.push({ component: 'content/heading', data: { text: data.heading }, settings: { level: 'h2', align: 'center', padding: ('4px' if data.intro else '@spacing.sm') } }) %][% endif %]
[% if data.intro %][% set _ = head.push({ component: 'content/text', data: { text: data.intro }, settings: { align: 'center', padding: '0' } }) %][% endif %]
[% if head.length %]
[[ c('layout/section', { content: head }, { settings: { background: s.background, padding: s.paddingY + ' ' + s.paddingX + ' 0 ' + s.paddingX, hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
[% endif %]
[% if s.layout == 'horizontal' %]
[% set items = [] %]
[% for st in data.steps %]
[% set num = (('0' + loop.index) if (s.numbering == 'zero' and loop.index < 10) else (loop.index | string)) %]
[% set _ = items.push([{ component: 'decorative/number-marker', data: { number: num }, variant: s.shape, settings: { align: 'center' } }, { component: 'content/heading', data: { text: st.title }, settings: { level: 'h4', tag: 'h3', align: 'center', padding: '0 0 4px 0' } }, { component: 'content/text', data: { text: st.description or ' ' }, settings: { level: 'bodySmall', align: 'center', padding: '0' } }]) %]
[% endfor %]
[[ c('layout/grid', { items: items }, { settings: { columns: (data.steps | length), mobileColumns: 1, background: s.background, paddingY: s.paddingY, paddingX: s.paddingX, columnPadding: '@spacing.sm', hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
[% else %]
[% for st in data.steps %]
[% set num = (('0' + loop.index) if (s.numbering == 'zero' and loop.index < 10) else (loop.index | string)) %]
[% set body = [{ component: 'content/heading', data: { text: st.title }, settings: { level: 'h3', tag: 'h3', padding: '0 0 4px 0' } }] %]
[% if st.description %][% set _ = body.push({ component: 'content/text', data: { text: st.description }, settings: { padding: '0' } }) %][% endif %]
[[ c('layout/columns', { columns: [[{ component: 'decorative/number-marker', data: { number: num }, variant: s.shape }], body] }, { settings: { split: '18/82', valign: 'top', mobileLayout: 'preserve', background: s.background, padding: (s.paddingY if loop.first and not head.length else '@spacing.sm') + ' ' + s.paddingX + ' ' + (s.paddingY if loop.last else '@spacing.sm') + ' ' + s.paddingX, columnPadding: '0 @spacing.xs', hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
[% endfor %]
[% endif %]
[% if data.cta %]
[[ c('layout/section', { content: [{ component: 'content/button', data: data.cta, settings: { padding: '0' } }] }, { settings: { background: s.background, padding: '0 ' + s.paddingX + ' ' + s.paddingY + ' ' + s.paddingX, hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
[% endif %]
