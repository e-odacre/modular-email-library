[# promotional/discount-banner: a full-width band with the discount in large type, a headline, an optional code and a button.

   Built from library components on a colored background. The discount ("25% OFF") is the visual anchor, the code
   is a discount-code box, and everything follows the theme. The discount value, code and expiry are plain text,
   so pass Klaviyo tags where you need them, for example {% coupon_code 'SUMMER25' %}.

   Compatibility
   - Outlook desktop: all parts are tables or text, honored.
   - Gmail apps: fine.
   - Dark mode: on the brand surface (light variant) text and background swap, on colored bands the colors stay. #]
[% set tn = tone(s) %]
[% set nodes = [] %]
[% set _ = nodes.push({ component: 'content/heading', data: { text: data.discount }, settings: { level: 'display', tag: 'div', align: s.align, color: tn.color, darkMode: tn.darkMode, padding: '0' } }) %]
[% if data.headline %][% set _ = nodes.push({ component: 'content/heading', data: { text: data.headline }, settings: { level: 'h3', tag: 'h2', align: s.align, color: tn.color, darkMode: tn.darkMode, padding: '@spacing.xs 0 @spacing.sm 0' } }) %][% endif %]
[% if data.text %][% set _ = nodes.push({ component: 'content/text', data: { text: data.text }, settings: { align: s.align, color: tn.color, darkMode: tn.darkMode, padding: '0 0 @spacing.sm 0' } }) %][% endif %]
[% if data.code %][% set _ = nodes.push({ component: 'promotional/discount-code', data: { code: data.code, expires: data.expires }, variant: ('default' if tn.onSurface else 'on-color'), settings: { align: s.align } }) %][% endif %]
[% if data.cta %][% set _ = nodes.push({ component: 'content/button', data: data.cta, settings: { align: s.align, background: s.buttonBackground, color: s.buttonColor, darkMode: tn.buttonDark, padding: '@spacing.md 0 0 0' } }) %][% endif %]
[[ c('layout/section', { content: nodes }, { settings: { background: s.background, padding: s.padding, hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
