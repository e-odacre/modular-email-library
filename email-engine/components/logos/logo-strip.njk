[# logos/logo-strip: a row of logos with an optional label: "Trusted by", "As seen in", partners or clients.

   The trusted-by, partner-logos, client-logos and press-logos layouts are variants (they differ in label style and
   spacing). Logos are images with required alt text, sized by `logoWidth` unless a logo sets its own width. Use logos
   with transparent or matching backgrounds, images are not recolored in dark mode, so mid-tone or dark-on-light
   logos on a light surface are safest. Only show logos you have permission to use.

   Compatibility
   - Outlook desktop: images with fixed widths, honored.
   - Gmail apps: fine. Images can be blocked, so the alt text (the company name) is what shows.
   - Dark mode: the label swaps via dm-muted, logos are not recolored. #]
[% set head = [] %]
[% if data.label %][% set _ = head.push({ component: 'content/text', data: { text: data.label }, settings: { level: 'caption', align: 'center', color: s.labelColor, padding: '0 0 @spacing.sm 0' } }) %][% endif %]
[% if head.length %]
[[ c('layout/section', { content: head }, { settings: { background: s.background, padding: s.paddingY + ' ' + s.paddingX + ' 0 ' + s.paddingX, hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
[% endif %]
[% set items = [] %]
[% for l in data.logos %][% set _ = items.push([{ component: 'content/image', data: { image: { src: l.src, alt: l.alt, href: l.href, width: (l.width or s.logoWidth) } }, settings: { padding: '0', align: 'center' } }]) %][% endfor %]
[[ c('layout/grid', { items: items }, { settings: { columns: s.columns, mobileColumns: s.mobileColumns, valign: 'middle', background: s.background, paddingY: (s.gap if head.length else s.paddingY), paddingX: s.paddingX, columnPadding: s.columnPadding, hideOnMobile: s.hideOnMobile, hideOnDesktop: s.hideOnDesktop } }) ]]
[% if head.length %]
[[ c('layout/gap', {}, { settings: { background: s.background, height: '@spacing.md' } }) ]]
[% endif %]
